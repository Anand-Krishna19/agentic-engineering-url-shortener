{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urlshort:schema:change-record:1.0.0",
  "title": "API or schema change record",
  "description": "Every API or schema change identifies ownership, version impact, backward-compatibility impact, affected consumers, tests, documentation, rollout or migration steps, and required change approval (plan requirement; FR-126, Constitution VI).",
  "type": "object",
  "required": ["change_id", "title", "contract", "owner", "from_version", "to_version", "version_impact", "backward_compatibility", "affected_consumers", "tests", "documentation", "rollout_or_migration", "required_approval", "impact_analysis_ref"],
  "additionalProperties": false,
  "properties": {
    "change_id": { "type": "string", "pattern": "^CHG-[0-9]{3}$" },
    "title": { "type": "string", "minLength": 1 },
    "contract": { "type": "string", "enum": ["shortener-api", "control-plane-api", "persistence-shortener", "persistence-orchestrator", "audit-event", "workflow-state", "policy-catalogue", "other-schema"] },
    "owner": { "type": "string", "minLength": 1, "description": "Owning plane or component." },
    "from_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "to_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "version_impact": { "type": "string", "enum": ["MAJOR", "MINOR", "PATCH"] },
    "backward_compatibility": {
      "type": "object",
      "required": ["compatible", "breaking_changes", "notes"],
      "additionalProperties": false,
      "properties": {
        "compatible": { "type": "boolean" },
        "breaking_changes": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "affected_consumers": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Test identifiers added or revalidated." },
    "documentation": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "rollout_or_migration": {
      "type": "object",
      "required": ["steps", "rollback_or_compensation"],
      "additionalProperties": false,
      "properties": {
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "migration_script": { "type": "string" },
        "rollback_or_compensation": { "type": "string", "minLength": 1 }
      }
    },
    "required_approval": {
      "type": "object",
      "required": ["gate", "status"],
      "additionalProperties": false,
      "properties": {
        "gate": { "type": "string", "enum": ["G-CHG", "G-ARCH", "G-SEC"] },
        "status": { "type": "string", "enum": ["REQUIRED", "APPROVED", "REJECTED"] },
        "approval_id": { "type": "string" }
      }
    },
    "impact_analysis_ref": { "type": "string", "minLength": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "version_impact": { "const": "MAJOR" } } },
      "then": { "properties": { "backward_compatibility": { "type": "object", "properties": { "compatible": { "const": false } } } } }
    },
    {
      "if": { "properties": { "backward_compatibility": { "type": "object", "properties": { "compatible": { "const": false } } } } },
      "then": { "properties": { "version_impact": { "const": "MAJOR" } } }
    }
  ]
}
