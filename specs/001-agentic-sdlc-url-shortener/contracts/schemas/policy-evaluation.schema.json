{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:urlshort:schema:policy-evaluation:1.0.0",
  "title": "Policy evaluation result",
  "description": "Exactly one outcome per applicable policy per evaluation point (FR-124). Inputs and outputs of the compliance-check stage. A FAIL on a mandatory policy blocks downstream progression (FR-125).",
  "type": "object",
  "required": ["evaluation_id", "run_id", "plan_version", "policy_id", "catalogue_version", "stage_key", "outcome", "mandatory", "reason", "evaluated_by_type", "evaluated_at", "clock_kind"],
  "additionalProperties": false,
  "properties": {
    "evaluation_id": { "type": "string" },
    "run_id": { "type": "string" },
    "plan_version": { "type": "integer", "minimum": 1 },
    "policy_id": { "type": "string", "pattern": "^POL-[A-Z]+-[0-9]{3}$" },
    "catalogue_version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+$" },
    "stage_key": { "type": "string", "pattern": "^N[0-9]{2}_[A-Z_]+$" },
    "outcome": { "type": "string", "enum": ["PASS", "FAIL", "EXCEPTION-REQUESTED", "NOT-APPLICABLE"] },
    "mandatory": { "type": "boolean" },
    "reason": { "type": "string", "minLength": 1 },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "exception_id": { "type": ["string", "null"], "description": "Present when an approved exception covers a FAIL." },
    "evaluated_by_type": { "type": "string", "enum": ["SYSTEM", "HUMAN"] },
    "evaluated_at": { "type": "string", "format": "date-time" },
    "clock_kind": { "type": "string", "enum": ["WALL", "SIMULATED"] }
  },
  "allOf": [
    {
      "if": { "properties": { "outcome": { "const": "EXCEPTION-REQUESTED" } } },
      "then": { "required": ["exception_id"], "properties": { "exception_id": { "type": "string", "minLength": 1 } } }
    }
  ]
}
